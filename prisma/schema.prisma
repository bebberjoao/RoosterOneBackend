generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String  @id @default(uuid()) @db.Uuid
  nome          String  @db.VarChar(150)
  email         String  @unique @db.VarChar(150)
  senhaHash     String  @map("senha_hash") @db.VarChar(255)
  cpf           String? @db.VarChar(14)
  telefone      String? @db.VarChar(20)
  ativo         Boolean @default(true)
  ultimoLogin   DateTime? @map("ultimo_login") @db.Timestamp()
  criadoEm      DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm  DateTime? @map("atualizado_em") @db.Timestamp()

  permissoes    UsuarioPermissao[]
  setores       UsuarioSetor[]
  notificacoes  Notificacao[]
  sessoes       Sessao[]
  logsAuditoria LogAuditoria[]
  ticketsCriados Ticket[] @relation("TicketSolicitante")
  ticketsTecnico Ticket[] @relation("TicketTecnico")
  mensagensTickets MensagemTicket[]
  anexosTickets AnexoTicket[]
  historicoTickets HistoricoTicket[]
  avaliacoesTickets AvaliacaoTicket[]
  subcategoriasAtendidas AtendimentoSubcategoria[]
  mensagensReservas ReservaMensagem[]
  historicoReservas ReservaHistorico[]
  redefinicoesSenha RedefinicaoSenha[]
  professorAcademico Professor?
  alunoAcademico     Aluno?

  @@map("usuarios")
}

model RedefinicaoSenha {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm  DateTime  @map("expira_em") @db.Timestamp()
  usadoEm   DateTime? @map("usado_em") @db.Timestamp()
  criadoEm  DateTime  @default(now()) @map("criado_em") @db.Timestamp()

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("redefinicoes_senha")
}

model Setor {
  id          String  @id @default(uuid()) @db.Uuid
  nome        String  @db.VarChar(100)
  descricao   String?
  ativo       Boolean @default(true)
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  usuarios    UsuarioSetor[]
  categorias  CategoriaTicket[]

  @@map("setores")
}

model Modulo {
  id          String  @id @default(uuid()) @db.Uuid
  nome        String  @unique @db.VarChar(80)
  rota        String? @db.VarChar(150)
  icone       String? @db.VarChar(80)
  ativo       Boolean @default(true)
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  permissoes  Permissao[]

  @@map("modulos")
}

model Permissao {
  id          String  @id @default(uuid()) @db.Uuid
  moduloId    String? @map("modulo_id") @db.Uuid
  nome        String  @db.VarChar(120)
  descricao   String?
  recurso     String? @db.VarChar(120)
  acao        String? @db.VarChar(50)
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  modulo      Modulo? @relation(fields: [moduloId], references: [id])
  usuarios    UsuarioPermissao[]

  @@map("permissoes")
}

model UsuarioPermissao {
  id          String  @id @default(uuid()) @db.Uuid
  usuarioId   String  @map("usuario_id") @db.Uuid
  permissaoId String  @map("permissao_id") @db.Uuid
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permissaoId])

  @@map("usuarios_permissoes")
}

model UsuarioSetor {
  id          String  @id @default(uuid()) @db.Uuid
  usuarioId   String  @map("usuario_id") @db.Uuid
  setorId     String  @map("setor_id") @db.Uuid
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  setor       Setor @relation(fields: [setorId], references: [id])

  @@unique([usuarioId, setorId])

  @@map("usuarios_setores")
}

model Notificacao {
  id          String  @id @default(uuid()) @db.Uuid
  usuarioId   String? @map("usuario_id") @db.Uuid
  titulo      String? @db.VarChar(150)
  mensagem    String?
  lida        Boolean @default(false)
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("notificacoes")
}

model Sessao {
  id            String  @id @default(uuid()) @db.Uuid
  usuarioId     String? @map("usuario_id") @db.Uuid
  refreshToken  String? @map("refresh_token") @db.VarChar(500)
  ip            String? @db.VarChar(45)
  navegador     String?
  expiraEm      DateTime? @map("expira_em") @db.Timestamp()
  revogada      Boolean @default(false)
  criadoEm      DateTime? @map("criado_em") @db.Timestamp()

  usuario       Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("sessoes")
}

model LogAuditoria {
  id            String  @id @default(uuid()) @db.Uuid
  usuarioId     String? @map("usuario_id") @db.Uuid
  modulo        String? @db.VarChar(80)
  acao          String? @db.VarChar(80)
  entidade      String? @db.VarChar(100)
  entidadeId    String? @map("entidade_id") @db.Uuid
  ip            String? @db.VarChar(45)
  navegador     String?
  criadoEm      DateTime? @map("criado_em") @db.Timestamp()

  usuario       Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
  @@map("logs_auditoria")
}

model CategoriaTicket {
  id          String  @id @default(uuid()) @db.Uuid
  nome        String  @db.VarChar(100)
  descricao   String?
  ativo       Boolean @default(true)
  slaHoras    Int     @default(8) @map("sla_horas")
  setorId     String? @map("setor_id") @db.Uuid
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  subcategorias SubcategoriaTicket[]
  tickets       Ticket[]
  setor         Setor? @relation(fields: [setorId], references: [id])

  @@index([setorId])
  @@map("categorias_tickets")
}

model SubcategoriaTicket {
  id          String  @id @default(uuid()) @db.Uuid
  categoriaId String? @map("categoria_id") @db.Uuid
  nome        String  @db.VarChar(100)
  descricao   String?
  ativo       Boolean @default(true)
  slaHoras    Int     @default(8) @map("sla_horas")
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  categoria CategoriaTicket? @relation(fields: [categoriaId], references: [id])
  tickets   Ticket[]
  atendentes AtendimentoSubcategoria[]

  @@map("subcategorias_tickets")
}

model AtendimentoSubcategoria {
  id             String @id @default(uuid()) @db.Uuid
  subcategoriaId String @map("subcategoria_id") @db.Uuid
  usuarioId      String @map("usuario_id") @db.Uuid
  criadoEm       DateTime? @map("criado_em") @db.Timestamp()

  subcategoria SubcategoriaTicket @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)
  usuario      Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([subcategoriaId, usuarioId])
  @@map("atendimentos_subcategorias")
}

model PrioridadeTicket {
  // Sem @default até 2026-09: a migration 20260819203000_fixed_ticket_priorities
  // trocou o tipo de UUID para TEXT (pra caber os ids fixos '1'-'4' do seed) e
  // derrubou o @default(uuid()) junto — sem querer, a julgar pelo schema de
  // teste (schema.test.prisma), que nunca perdeu o default. Efeito real: criar
  // uma prioridade nova via POST /chamados-prioridades funcionava no SQLite de
  // teste (tinha default) e falharia no Postgres de produção (não tinha) —
  // "null value in column id violates not-null constraint". Nunca chegou a
  // quebrar em produção porque ninguém tinha cadastrado uma prioridade além
  // das 4 do seed ainda.
  id       String  @id @default(uuid())
  nome     String  @db.VarChar(50)
  cor      String? @db.VarChar(20)
  criadoEm DateTime? @map("criado_em") @db.Timestamp()

  tickets Ticket[]

  @@map("prioridades_tickets")
}

model StatusTicket {
  id        String  @id @default(uuid()) @db.Uuid
  nome      String  @db.VarChar(60)
  ordem     Int?
  encerrado Boolean @default(false)
  criadoEm  DateTime? @map("criado_em") @db.Timestamp()

  tickets Ticket[]

  @@map("status_tickets")
}

model Ticket {
  id             String  @id @default(uuid()) @db.Uuid
  protocolo      String? @unique @db.VarChar(30)
  titulo         String  @db.VarChar(200)
  descricao      String
  usuarioId      String? @map("usuario_id") @db.Uuid
  tecnicoId      String? @map("tecnico_id") @db.Uuid
  categoriaId    String? @map("categoria_id") @db.Uuid
  subcategoriaId String? @map("subcategoria_id") @db.Uuid
  prioridadeId   String? @map("prioridade_id")
  statusId       String? @map("status_id") @db.Uuid
  tags           String[] @default([])
  favorito       Boolean  @default(false)
  criadoEm       DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm   DateTime? @map("atualizado_em") @db.Timestamp()
  encerradoEm    DateTime? @map("encerrado_em") @db.Timestamp()

  usuario      Usuario? @relation("TicketSolicitante", fields: [usuarioId], references: [id])
  tecnico      Usuario? @relation("TicketTecnico", fields: [tecnicoId], references: [id])
  categoria    CategoriaTicket? @relation(fields: [categoriaId], references: [id])
  subcategoria SubcategoriaTicket? @relation(fields: [subcategoriaId], references: [id])
  prioridade   PrioridadeTicket? @relation(fields: [prioridadeId], references: [id])
  status       StatusTicket? @relation(fields: [statusId], references: [id])
  mensagens    MensagemTicket[]
  anexos       AnexoTicket[]
  historico    HistoricoTicket[]
  avaliacoes   AvaliacaoTicket[]

  @@index([categoriaId])
  @@index([criadoEm])
  @@map("tickets")
}

model MensagemTicket {
  id         String    @id @default(uuid()) @db.Uuid
  ticketId   String    @map("ticket_id") @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  mensagem   String
  interno    Boolean   @default(false)
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamp()
  removidoEm DateTime? @map("removido_em") @db.Timestamp()

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([ticketId, criadoEm])
  @@map("mensagens_tickets")
}

model AnexoTicket {
  id          String  @id @default(uuid()) @db.Uuid
  ticketId    String? @map("ticket_id") @db.Uuid
  usuarioId   String? @map("usuario_id") @db.Uuid
  nomeArquivo String? @map("nome_arquivo") @db.VarChar(255)
  caminho     String?
  tipo        String? @db.VarChar(80)
  tamanho     BigInt?
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  ticket  Ticket? @relation(fields: [ticketId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("anexos_tickets")
}

model HistoricoTicket {
  id         String  @id @default(uuid()) @db.Uuid
  ticketId   String? @map("ticket_id") @db.Uuid
  usuarioId  String? @map("usuario_id") @db.Uuid
  campo      String? @db.VarChar(100)
  valorAntigo String? @map("valor_antigo")
  valorNovo  String? @map("valor_novo")
  criadoEm   DateTime? @map("criado_em") @db.Timestamp()

  ticket  Ticket? @relation(fields: [ticketId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("historico_tickets")
}

model AvaliacaoTicket {
  id        String  @id @default(uuid()) @db.Uuid
  ticketId  String? @map("ticket_id") @db.Uuid
  usuarioId String? @map("usuario_id") @db.Uuid
  nota      Int?
  comentario String?
  criadoEm  DateTime? @map("criado_em") @db.Timestamp()

  ticket  Ticket? @relation(fields: [ticketId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("avaliacoes_tickets")
}

model Campus {
  id          String    @id @default(uuid()) @db.Uuid
  nome        String    @db.VarChar(120)
  codigo      String    @unique @db.VarChar(20)
  endereco    String?
  cidade      String?
  estado      String?
  cep         String?
  responsavel String?
  ativo       Boolean   @default(true)
  observacoes String?
  cor         String?
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamp()

  blocos     Bloco[]
  ambientes  Ambiente[]

  @@map("campus")
}

model Bloco {
  id          String    @id @default(uuid()) @db.Uuid
  campusId    String    @map("campus_id") @db.Uuid
  nome        String    @db.VarChar(120)
  codigo      String    @db.VarChar(20)
  andares     Int       @default(1)
  responsavel String?
  ativo       Boolean   @default(true)
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamp()

  campus    Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)
  ambientes Ambiente[]

  @@unique([campusId, codigo])
  @@map("blocos")
}

model Ambiente {
  id                String    @id @default(uuid()) @db.Uuid
  campusId          String    @map("campus_id") @db.Uuid
  blocoId           String    @map("bloco_id") @db.Uuid
  nome              String    @db.VarChar(120)
  codigo            String    @unique @db.VarChar(30)
  andar             Int       @default(0)
  numero            String?
  tipo              String    @db.VarChar(40)
  capacidade        Int       @default(0)
  area              Decimal?  @db.Decimal(8, 2)
  descricao         String?
  capa              String?
  galeria           String[]  @default([])
  recursos          String[]  @default([])
  status            String    @default("disponivel") @db.VarChar(30)
  horarioAbertura   String?   @map("horario_abertura") @db.VarChar(20)
  diasFuncionamento String[]  @default([]) @map("dias_funcionamento")
  duracaoMinutos    Int?      @map("duracao_minutos")
  criadoEm          DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm      DateTime? @map("atualizado_em") @db.Timestamp()

  campus   Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  bloco    Bloco     @relation(fields: [blocoId], references: [id], onDelete: Cascade)
  reservas Reserva[]

  @@map("ambientes")
}

model Reserva {
  id            String    @id @default(uuid()) @db.Uuid
  codigo        String    @unique @db.VarChar(40)
  ambienteId    String    @map("ambiente_id") @db.Uuid
  responsavelId String?   @map("responsavel_id") @db.Uuid
  responsavel   String    @db.VarChar(120)
  setorId       String?   @map("setor_id") @db.Uuid
  setor         String?   @db.VarChar(120)
  evento        String    @db.VarChar(200)
  finalidade    String?
  data          DateTime  @db.Date
  horarioInicio String    @map("horario_inicio") @db.VarChar(20)
  horarioFim    String    @map("horario_fim") @db.VarChar(20)
  participantes Int       @default(1)
  status        String    @default("analise") @db.VarChar(20)
  recorrencia   String    @default("unica") @db.VarChar(20)
  serieId       String?   @map("serie_id") @db.Uuid
  serieTotal    Int?      @map("serie_total")
  observacoes   String?
  decididoPor   String?   @map("decidido_por") @db.Uuid
  decididoEm    DateTime? @map("decidido_em") @db.Timestamp()
  motivoCancelamento String? @map("motivo_cancelamento")
  criadoEm      DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm  DateTime? @map("atualizado_em") @db.Timestamp()

  ambiente  Ambiente @relation(fields: [ambienteId], references: [id], onDelete: Restrict)
  mensagens ReservaMensagem[]
  historico ReservaHistorico[]

  @@index([serieId])
  @@map("reservas")
}

model ReservaMensagem {
  id         String    @id @default(uuid()) @db.Uuid
  reservaId  String    @map("reserva_id") @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  mensagem   String
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamp()

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([reservaId, criadoEm])
  @@map("reservas_mensagens")
}

model ReservaHistorico {
  id          String    @id @default(uuid()) @db.Uuid
  reservaId   String    @map("reserva_id") @db.Uuid
  usuarioId   String?   @map("usuario_id") @db.Uuid
  campo       String?   @db.VarChar(100)
  valorAntigo String?   @map("valor_antigo")
  valorNovo   String?   @map("valor_novo")
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  reserva Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("reservas_historico")
}

model PatrimonioCategoria {
  id          String       @id @default(uuid()) @db.Uuid
  nome        String       @unique @db.VarChar(100)
  descricao   String?
  tom         String?      @db.VarChar(40)
  sistema     Boolean      @default(false)
  criadoEm    DateTime?    @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime?   @map("atualizado_em") @db.Timestamp()

  patrimonios Patrimonio[]

  @@map("patrimonio_categorias")
}

model PatrimonioSetor {
  id          String      @id @default(uuid()) @db.Uuid
  nome        String      @unique @db.VarChar(100)
  descricao   String?
  responsavel String?
  criadoEm    DateTime?   @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime?  @map("atualizado_em") @db.Timestamp()

  patrimonios Patrimonio[]

  @@map("patrimonio_setores")
}

model Patrimonio {
  id                   String               @id @default(uuid()) @db.Uuid
  nome                 String               @db.VarChar(150)
  tag                  String               @unique @db.VarChar(80)
  categoriaId          String               @map("categoria_id") @db.Uuid
  marca                String?
  modelo               String?
  serial               String?
  localizacaoId        String?              @map("localizacao_id") @db.Uuid
  localizacao          String?              @db.VarChar(200)
  setorId              String?              @map("setor_id") @db.Uuid
  setor                String?              @db.VarChar(120)
  responsavelUserId    String?              @map("responsavel_user_id") @db.Uuid
  responsavel          String?              @db.VarChar(120)
  status               String               @default("disponivel") @db.VarChar(30)
  condicao             String               @default("bom") @db.VarChar(30)
  adquiridoEm          DateTime?            @map("adquirido_em") @db.Date
  valor                Decimal              @default(0) @db.Decimal(12, 2)
  observacoes          String?
  foto                 String?
  chamadoManutencaoId  String?              @map("chamado_manutencao_id") @db.Uuid
  criadoEm             DateTime?            @map("criado_em") @db.Timestamp()
  atualizadoEm         DateTime?            @map("atualizado_em") @db.Timestamp()

  categoria   PatrimonioCategoria @relation(fields: [categoriaId], references: [id])
  setorRef    PatrimonioSetor?    @relation(fields: [setorId], references: [id])
  movimentacoes PatrimonioMovimento[]

  @@map("patrimonio")
}

model PatrimonioMovimento {
  id          String    @id @default(uuid()) @db.Uuid
  patrimonioId String    @map("patrimonio_id") @db.Uuid
  tipo        String    @db.VarChar(40)
  origem      String?
  destino     String?
  usuario     String    @db.VarChar(120)
  observacoes String?
  dataDevolucaoPrevista DateTime? @map("data_devolucao_prevista") @db.Date
  devolvidoEm           DateTime? @map("devolvido_em") @db.Timestamp()
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  patrimonio Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)

  @@map("patrimonio_movimentacoes")
}

// =====================================================================
// Rooster Academy
//
// Disciplina é o catálogo (curricular, independente de período) — corrige
// o modelo do mock do frontend, que prendia termId/teacherId direto na
// disciplina e travava a oferta a um único período/professor por vez.
// A oferta de fato (período + professor + horário + sala + turno) é a
// Turma. Aluno/Professor são entidades acadêmicas ligadas por FK a
// Usuario (Hub) — não duplicam a tabela usuarios.
// =====================================================================

model Curso {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String    @db.VarChar(150)
  codigo       String    @unique @db.VarChar(30)
  grau         String    @db.VarChar(30) // Graduação | Pós-graduação | Técnico | Extensão
  ativo        Boolean   @default(true)
  criadoEm     DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamp()

  disciplinas Disciplina[]
  alunos      Aluno[]

  @@map("cursos")
}

model PeriodoLetivo {
  id         String    @id @default(uuid()) @db.Uuid
  nome       String    @unique @db.VarChar(20) // "2026.1"
  dataInicio DateTime  @map("data_inicio") @db.Date
  dataFim    DateTime  @map("data_fim") @db.Date
  ativo      Boolean   @default(false)
  criadoEm   DateTime? @map("criado_em") @db.Timestamp()

  turmas Turma[]

  @@map("periodos_letivos")
}

model Disciplina {
  id           String    @id @default(uuid()) @db.Uuid
  codigo       String    @unique @db.VarChar(30)
  nome         String    @db.VarChar(150)
  descricao    String?
  cursoId      String    @map("curso_id") @db.Uuid
  cargaHoraria Int       @map("carga_horaria")
  status       String    @default("ativa") @db.VarChar(20) // ativa | arquivada | inativa
  criadoEm     DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamp()

  curso      Curso                @relation(fields: [cursoId], references: [id])
  turmas     Turma[]
  documentos DocumentoAcademico[]

  @@map("disciplinas")
}

model Professor {
  id                  String    @id @default(uuid()) @db.Uuid
  usuarioId           String    @unique @map("usuario_id") @db.Uuid
  titulacao           String?   @db.VarChar(50) // "Prof. Dr."
  departamento        String?   @db.VarChar(100)
  cargaHorariaSemanal Int?      @map("carga_horaria_semanal")
  status              String    @default("ativo") @db.VarChar(20) // ativo | afastado | inativo
  criadoEm            DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm        DateTime? @map("atualizado_em") @db.Timestamp()

  usuario    Usuario     @relation(fields: [usuarioId], references: [id])
  turmas     Turma[]
  atividades Atividade[]
  orientacoesBoost CursoOrientadorBoost[]
  mensagensBoost   MensagemBoost[]

  @@map("professores")
}

model Aluno {
  id           String    @id @default(uuid()) @db.Uuid
  usuarioId    String    @unique @map("usuario_id") @db.Uuid
  ra           String    @unique @db.VarChar(20)
  cursoId      String    @map("curso_id") @db.Uuid
  semestre     Int       @default(1)
  situacao     String    @default("ativo") @db.VarChar(20) // ativo | trancado | formado | inativo
  criadoEm     DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamp()

  usuario     Usuario              @relation(fields: [usuarioId], references: [id])
  curso       Curso                @relation(fields: [cursoId], references: [id])
  matriculas  Matricula[]
  frequencias RegistroFrequencia[]
  notas       Nota[]
  entregas    Entrega[]
  cobrancas       Cobranca[]
  descontos       DescontoAluno[]

  @@map("alunos")
}

model Turma {
  id              String    @id @default(uuid()) @db.Uuid
  codigo          String    @db.VarChar(40)
  disciplinaId    String    @map("disciplina_id") @db.Uuid
  periodoLetivoId String    @map("periodo_letivo_id") @db.Uuid
  professorId     String?   @map("professor_id") @db.Uuid
  turno           String?   @db.VarChar(20) // Matutino | Vespertino | Noturno
  capacidade      Int       @default(0)
  sala            String?   @db.VarChar(150) // texto livre — ver docs/engineering (integração futura com Rooms)
  horario         String?   @db.VarChar(100) // "Ter/Qui 19:00-22:30"
  status          String    @default("aberta") @db.VarChar(20) // aberta | em-andamento | encerrada
  criadoEm        DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm    DateTime? @map("atualizado_em") @db.Timestamp()

  disciplina       Disciplina         @relation(fields: [disciplinaId], references: [id])
  periodoLetivo    PeriodoLetivo      @relation(fields: [periodoLetivoId], references: [id])
  professor        Professor?         @relation(fields: [professorId], references: [id])
  matriculas       Matricula[]
  frequencias      RegistroFrequencia[]
  itensAvaliativos ItemAvaliativo[]
  atividades       Atividade[]

  @@unique([codigo, periodoLetivoId])
  @@map("turmas")
}

model Matricula {
  id           String    @id @default(uuid()) @db.Uuid
  alunoId      String    @map("aluno_id") @db.Uuid
  turmaId      String    @map("turma_id") @db.Uuid
  status       String    @default("ativa") @db.VarChar(20) // ativa | trancada | concluida | cancelada
  criadoEm     DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamp()

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, turmaId])
  @@map("matriculas")
}

model RegistroFrequencia {
  id              String    @id @default(uuid()) @db.Uuid
  turmaId         String    @map("turma_id") @db.Uuid
  alunoId         String    @map("aluno_id") @db.Uuid
  data            DateTime  @db.Date
  presenca        String    @db.VarChar(20) // presente | falta | atraso | justificado
  registradoPorId String?   @map("registrado_por_id") @db.Uuid
  criadoEm        DateTime? @map("criado_em") @db.Timestamp()

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([turmaId, alunoId, data])
  @@index([alunoId])
  @@map("registros_frequencia")
}

model ItemAvaliativo {
  id          String    @id @default(uuid()) @db.Uuid
  turmaId     String    @map("turma_id") @db.Uuid
  nome        String    @db.VarChar(120)
  peso        Decimal   @db.Decimal(4, 3) // 0..1
  notaMaxima  Decimal   @default(10) @map("nota_maxima") @db.Decimal(4, 2)
  origem      String    @default("manual") @db.VarChar(10) // manual | learn
  atividadeId String?   @unique @map("atividade_id") @db.Uuid
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  turma     Turma      @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  atividade Atividade? @relation(fields: [atividadeId], references: [id])
  notas     Nota[]

  @@map("itens_avaliativos")
}

model Nota {
  id               String    @id @default(uuid()) @db.Uuid
  itemAvaliativoId String    @map("item_avaliativo_id") @db.Uuid
  alunoId          String    @map("aluno_id") @db.Uuid
  valor            Decimal?  @db.Decimal(4, 2)
  lancadoPorId     String?   @map("lancado_por_id") @db.Uuid
  atualizadoEm     DateTime? @map("atualizado_em") @db.Timestamp()

  itemAvaliativo ItemAvaliativo @relation(fields: [itemAvaliativoId], references: [id], onDelete: Cascade)
  aluno          Aluno          @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([itemAvaliativoId, alunoId])
  @@map("notas")
}

model EventoCalendarioAcademico {
  id       String    @id @default(uuid()) @db.Uuid
  titulo   String    @db.VarChar(150)
  data     DateTime  @db.Date
  dataFim  DateTime? @map("data_fim") @db.Date
  horario  String?   @db.VarChar(30)
  tipo     String    @db.VarChar(30) // semestre | prova | feriado | reuniao | apresentacao | semana | institucional
  publico  String?   @db.VarChar(150)
  local    String?   @db.VarChar(150)
  criadoEm DateTime? @map("criado_em") @db.Timestamp()

  @@map("eventos_calendario_academico")
}

model DocumentoAcademico {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String    @db.VarChar(200)
  tipo         String    @db.VarChar(30) // plano-de-ensino | ementa | regulamento | institucional
  disciplinaId String?   @map("disciplina_id") @db.Uuid
  autorId      String?   @map("autor_id") @db.Uuid
  caminho      String?   @db.VarChar(255)
  tamanho      BigInt?
  criadoEm     DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamp()

  disciplina Disciplina? @relation(fields: [disciplinaId], references: [id])

  @@map("documentos_academicos")
}

// =====================================================================
// Rooster Learn
//
// Atividade referencia a Turma real do Academy (não duplica turma/aluno
// próprios, ao contrário do mock do frontend). Quando a atividade tem
// peso/nota, pode gerar um ItemAvaliativo (origem "learn") no Academy —
// ver rooster-learn.service.ts.
// =====================================================================

model Atividade {
  id             String    @id @default(uuid()) @db.Uuid
  codigo         String?   @unique @db.VarChar(30)
  titulo         String    @db.VarChar(200)
  tipo           String    @db.VarChar(20) // prova | lista | trabalho | questionario | material
  descricao      String?
  turmaId        String    @map("turma_id") @db.Uuid
  professorId    String?   @map("professor_id") @db.Uuid
  status         String    @default("rascunho") @db.VarChar(20) // rascunho | agendada | publicada | encerrada | arquivada
  peso           Decimal   @default(1) @db.Decimal(4, 3)
  notaMaxima     Decimal   @default(10) @map("nota_maxima") @db.Decimal(4, 2)
  abreEm         DateTime? @map("abre_em") @db.Timestamp()
  prazoEm        DateTime? @map("prazo_em") @db.Timestamp()
  tempoLimiteMin Int?      @map("tempo_limite_min")
  permiteAtraso  Boolean   @default(true) @map("permite_atraso")
  criadoEm       DateTime? @map("criado_em") @db.Timestamp()
  publicadoEm    DateTime? @map("publicado_em") @db.Timestamp()

  turma          Turma           @relation(fields: [turmaId], references: [id])
  professor      Professor?      @relation(fields: [professorId], references: [id])
  itemAvaliativo ItemAvaliativo?
  entregas       Entrega[]

  @@map("atividades")
}

model Entrega {
  id             String    @id @default(uuid()) @db.Uuid
  atividadeId    String    @map("atividade_id") @db.Uuid
  alunoId        String    @map("aluno_id") @db.Uuid
  status         String    @default("pendente") @db.VarChar(20) // pendente | enviada | corrigida | reenvio | atrasada
  texto          String?
  enviadoEm      DateTime? @map("enviado_em") @db.Timestamp()
  nota           Decimal?  @db.Decimal(4, 2)
  feedback       String?
  corrigidoPorId String?   @map("corrigido_por_id") @db.Uuid
  corrigidoEm    DateTime? @map("corrigido_em") @db.Timestamp()

  atividade Atividade      @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  aluno     Aluno          @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  anexos    AnexoEntrega[]

  @@unique([atividadeId, alunoId])
  @@map("entregas")
}

model AnexoEntrega {
  id          String    @id @default(uuid()) @db.Uuid
  entregaId   String    @map("entrega_id") @db.Uuid
  nomeArquivo String?   @map("nome_arquivo") @db.VarChar(255)
  caminho     String?   @db.VarChar(255)
  tipo        String?   @db.VarChar(80)
  tamanho     BigInt?
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  entrega Entrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  @@map("anexos_entrega")
}

// =====================================================================
// Rooster Boost
//
// Plataforma de cursos pública, com cadastro/login PRÓPRIOS (BoostUsuario),
// separados do login do Hub (Usuario) — ver src/rooster-boost-portal/ e
// docs/security. Curso não tem dono: quem gerencia é quem tem a permissão
// (RBAC do Hub). Professores do Academy entram como ORIENTADORES
// (CursoOrientadorBoost) e só conversam com os alunos; aluno é sempre um
// BoostUsuario (login público, nunca ligado a Usuario).
// =====================================================================

model BoostUsuario {
  id        String    @id @default(uuid()) @db.Uuid
  nome      String    @db.VarChar(150)
  email     String    @unique @db.VarChar(180)
  senhaHash String    @map("senha_hash") @db.VarChar(255)
  ativo     Boolean   @default(true)
  criadoEm  DateTime? @map("criado_em") @db.Timestamp()

  matriculas MatriculaBoost[]
  mensagens  MensagemBoost[]
  conversas  ConversaBoost[]

  @@map("boost_usuarios")
}

model CursoBoost {
  id               String    @id @default(uuid()) @db.Uuid
  titulo           String    @db.VarChar(200)
  slug             String    @unique @db.VarChar(220)
  descricao        String?
  categoria        String?   @db.VarChar(80)
  nivel            String    @default("iniciante") @db.VarChar(20) // iniciante | intermediario | avancado
  cargaHoraria     Int       @map("carga_horaria")
  capa             String?   @db.VarChar(255)
  status           String    @default("rascunho") @db.VarChar(20) // rascunho | publicado | arquivado
  emiteCertificado Boolean   @default(true) @map("emite_certificado")
  certificadoTexto String?   @map("certificado_texto") // modelo com {aluno}, {curso}, {cargaHoraria}, {data}
  criadoEm         DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm     DateTime? @map("atualizado_em") @db.Timestamp()

  modulos      ModuloBoost[]
  matriculas   MatriculaBoost[]
  orientadores CursoOrientadorBoost[]
  conversas    ConversaBoost[]

  @@map("cursos_boost")
}

// Professor vinculado a um curso para conversar com os alunos dele. Não dá poder
// de edição: a gestão do curso é só por permissão.
model CursoOrientadorBoost {
  id          String    @id @default(uuid()) @db.Uuid
  cursoId     String    @map("curso_id") @db.Uuid
  professorId String    @map("professor_id") @db.Uuid
  criadoEm    DateTime? @map("criado_em") @db.Timestamp()

  curso     CursoBoost @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  professor Professor  @relation(fields: [professorId], references: [id])

  @@unique([cursoId, professorId])
  @@map("cursos_orientadores_boost")
}

// Uma conversa contínua por (curso, aluno), atendida por qualquer orientador do curso.
model ConversaBoost {
  id               String    @id @default(uuid()) @db.Uuid
  cursoId          String    @map("curso_id") @db.Uuid
  boostUsuarioId   String    @map("boost_usuario_id") @db.Uuid
  criadoEm         DateTime? @map("criado_em") @db.Timestamp()
  ultimaMensagemEm DateTime? @map("ultima_mensagem_em") @db.Timestamp()

  curso        CursoBoost      @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  boostUsuario BoostUsuario    @relation(fields: [boostUsuarioId], references: [id], onDelete: Cascade)
  mensagens    MensagemBoost[]

  @@unique([cursoId, boostUsuarioId])
  @@map("conversas_boost")
}

model ModuloBoost {
  id      String @id @default(uuid()) @db.Uuid
  cursoId String @map("curso_id") @db.Uuid
  titulo  String @db.VarChar(200)
  ordem   Int    @default(0)

  curso CursoBoost @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  aulas AulaBoost[]

  @@map("modulos_boost")
}

model AulaBoost {
  id            String  @id @default(uuid()) @db.Uuid
  moduloId      String  @map("modulo_id") @db.Uuid
  titulo        String  @db.VarChar(200)
  ordem         Int     @default(0)
  tipo          String  @default("texto") @db.VarChar(20) // video | texto | pdf | link
  conteudoUrl   String? @map("conteudo_url") @db.VarChar(500)
  conteudoTexto String? @map("conteudo_texto")
  duracaoMin    Int?    @map("duracao_min")

  // Vídeo hospedado no servidor (arquivo em PASTAS.videosBoost(), nunca S3/nuvem).
  // Presença de videoArquivo é o que distingue "vídeo hospedado" de "link
  // externo" (conteudoUrl) — não há enum/flag separado de propósito, pra não
  // deixar os dois campos poderem divergir sobre qual é a fonte real.
  videoArquivo  String? @map("video_arquivo") @db.VarChar(255)
  videoTamanho  BigInt? @map("video_tamanho")
  videoMimeType String? @map("video_mime_type") @db.VarChar(80)

  modulo    ModuloBoost     @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  materiais MaterialApoio[]
  progresso ProgressoAula[]

  @@map("aulas_boost")
}

model MaterialApoio {
  id       String    @id @default(uuid()) @db.Uuid
  aulaId   String    @map("aula_id") @db.Uuid
  nome     String    @db.VarChar(200)
  caminho  String    @db.VarChar(255)
  tipo     String?   @db.VarChar(80)
  tamanho  BigInt?
  criadoEm DateTime? @map("criado_em") @db.Timestamp()

  aula AulaBoost @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@map("materiais_apoio_boost")
}

model MatriculaBoost {
  id             String    @id @default(uuid()) @db.Uuid
  boostUsuarioId String    @map("boost_usuario_id") @db.Uuid
  cursoId        String    @map("curso_id") @db.Uuid
  status         String    @default("ativa") @db.VarChar(20) // ativa | concluida | cancelada
  progressoPct   Int       @default(0) @map("progresso_pct")
  matriculadoEm  DateTime? @map("matriculado_em") @db.Timestamp()
  concluidoEm    DateTime? @map("concluido_em") @db.Timestamp()

  boostUsuario BoostUsuario       @relation(fields: [boostUsuarioId], references: [id], onDelete: Cascade)
  curso        CursoBoost         @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  progresso    ProgressoAula[]
  certificado  CertificadoBoost?

  @@unique([boostUsuarioId, cursoId])
  @@map("matriculas_boost")
}

model ProgressoAula {
  id          String    @id @default(uuid()) @db.Uuid
  matriculaId String    @map("matricula_id") @db.Uuid
  aulaId      String    @map("aula_id") @db.Uuid
  concluidoEm DateTime? @map("concluido_em") @db.Timestamp()

  // Progresso real de vídeo: posição para retomar de onde parou, e o maior
  // percentual já assistido (usado para completar automaticamente perto do
  // fim). Ficam null/0 para aulas que não são vídeo — o botão manual de
  // concluir continua sendo o caminho normal pra elas.
  posicaoSeg          Int? @default(0) @map("posicao_seg")
  percentualAssistido Int? @default(0) @map("percentual_assistido")

  matricula MatriculaBoost @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  aula      AulaBoost      @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([matriculaId, aulaId])
  @@map("progresso_aulas_boost")
}

model MensagemBoost {
  id             String    @id @default(uuid()) @db.Uuid
  conversaId     String    @map("conversa_id") @db.Uuid
  boostUsuarioId String?   @map("boost_usuario_id") @db.Uuid // autor se for aluno
  professorId    String?   @map("professor_id") @db.Uuid // autor se for orientador
  mensagem       String
  lidaEm         DateTime? @map("lida_em") @db.Timestamp() // lida pela OUTRA ponta
  criadoEm       DateTime? @map("criado_em") @db.Timestamp()

  conversa     ConversaBoost @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  boostUsuario BoostUsuario? @relation(fields: [boostUsuarioId], references: [id])
  professor    Professor?    @relation(fields: [professorId], references: [id])

  @@index([conversaId, criadoEm])
  @@map("mensagens_boost")
}

model CertificadoBoost {
  id          String    @id @default(uuid()) @db.Uuid
  matriculaId String    @unique @map("matricula_id") @db.Uuid
  codigo      String    @unique @db.VarChar(30)
  caminhoPdf  String    @map("caminho_pdf") @db.VarChar(255)
  emitidoEm   DateTime? @map("emitido_em") @db.Timestamp()

  matricula MatriculaBoost @relation(fields: [matriculaId], references: [id], onDelete: Cascade)

  @@map("certificados_boost")
}

// =====================================================================
// Rooster Finance
//
// Uma única entidade central, `Cobranca`, representa toda cobrança feita
// a um aluno real do Academy (mensalidade, produto, serviço ou taxa) —
// substitui o modelo fragmentado do mock do frontend, onde a mesma
// informação existia sob quatro nomes (Tuition/Charge/Boleto/Payment).
// Boleto/PIX são gerados e controlados 100% internamente (nossoNumero/
// linhaDigitavel/pixCopiaECola), sem integração com banco/PSP real —
// a baixa de pagamento é sempre manual pelo financeiro. NotaFiscal é um
// documento interno gerado em PDF (mesmo padrão do certificado do Boost),
// sem transmissão à SEFAZ — decisões confirmadas com o usuário.
// =====================================================================

model Produto {
  id            String    @id @default(uuid()) @db.Uuid
  codigo        String    @unique @db.VarChar(30)
  nome          String    @db.VarChar(150)
  categoria     String?   @db.VarChar(80)
  descricao     String?
  preco         Decimal   @db.Decimal(10, 2)
  estoque       Int       @default(0)
  estoqueMinimo Int       @default(0) @map("estoque_minimo")
  unidade       String    @default("un") @db.VarChar(20)
  ativo         Boolean   @default(true)
  criadoEm      DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm  DateTime? @map("atualizado_em") @db.Timestamp()

  cobrancas Cobranca[]

  @@map("produtos_financeiros")
}

model Servico {
  id           String    @id @default(uuid()) @db.Uuid
  nome         String    @db.VarChar(150)
  descricao    String?
  preco        Decimal   @db.Decimal(10, 2)
  categoria    String?   @db.VarChar(80)
  frequencia   String    @default("unico") @db.VarChar(20) // unico | mensal | anual | semestral
  ativo        Boolean   @default(true)
  criadoEm     DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm DateTime? @map("atualizado_em") @db.Timestamp()

  cobrancas Cobranca[]

  @@map("servicos_financeiros")
}

model Desconto {
  id              String    @id @default(uuid()) @db.Uuid
  nome            String    @db.VarChar(150)
  tipo            String    @db.VarChar(20) // bolsa-integral | bolsa-parcial | desc-percent | desc-fixo | convenio | promocao
  valor           Decimal   @db.Decimal(10, 2)
  unidade         String    @db.VarChar(10) // percent | fixo
  motivo          String?
  responsavel     String?   @db.VarChar(120)
  vigenciaInicio  DateTime? @map("vigencia_inicio") @db.Date
  vigenciaFim     DateTime? @map("vigencia_fim") @db.Date
  ativo           Boolean   @default(true)
  criadoEm        DateTime? @map("criado_em") @db.Timestamp()
  atualizadoEm    DateTime? @map("atualizado_em") @db.Timestamp()

  cobrancas Cobranca[]
  alunos    DescontoAluno[]

  @@map("descontos")
}

model DescontoAluno {
  id          String    @id @default(uuid()) @db.Uuid
  alunoId     String    @map("aluno_id") @db.Uuid
  descontoId  String    @map("desconto_id") @db.Uuid
  atribuidoEm DateTime? @map("atribuido_em") @db.Timestamp()

  aluno    Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  desconto Desconto @relation(fields: [descontoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, descontoId])
  @@map("descontos_alunos")
}

model Cobranca {
  id                 String    @id @default(uuid()) @db.Uuid
  alunoId            String    @map("aluno_id") @db.Uuid
  tipo               String    @db.VarChar(20) // mensalidade | produto | servico | taxa
  descricao          String    @db.VarChar(200)
  competencia        String?   @db.VarChar(20) // "2026-03", só mensalidade
  produtoId          String?   @map("produto_id") @db.Uuid
  servicoId          String?   @map("servico_id") @db.Uuid
  descontoId         String?   @map("desconto_id") @db.Uuid
  valorOriginal      Decimal   @map("valor_original") @db.Decimal(10, 2)
  valorDesconto      Decimal   @default(0) @map("valor_desconto") @db.Decimal(10, 2)
  multa              Decimal   @default(0) @db.Decimal(10, 2)
  juros              Decimal   @default(0) @db.Decimal(10, 2)
  valorPago          Decimal?  @map("valor_pago") @db.Decimal(10, 2)
  vencimento         DateTime  @db.Date
  status             String    @default("aberto") @db.VarChar(20) // aberto | pago | vencido | negociado | cancelado | processando
  formaPagamento     String?   @map("forma_pagamento") @db.VarChar(30)
  nossoNumero        String?   @unique @map("nosso_numero") @db.VarChar(40)
  linhaDigitavel     String?   @map("linha_digitavel") @db.VarChar(60)
  pixCopiaECola      String?   @map("pix_copia_e_cola") @db.VarChar(255)
  emitidoEm          DateTime? @map("emitido_em") @db.Timestamp()
  pagoEm             DateTime? @map("pago_em") @db.Timestamp()
  negociadoEm        DateTime? @map("negociado_em") @db.Timestamp()
  motivoCancelamento String?   @map("motivo_cancelamento")
  criadoEm           DateTime? @default(now()) @map("criado_em") @db.Timestamp()
  atualizadoEm       DateTime? @map("atualizado_em") @db.Timestamp()

  aluno      Aluno       @relation(fields: [alunoId], references: [id])
  produto    Produto?    @relation(fields: [produtoId], references: [id])
  servico    Servico?    @relation(fields: [servicoId], references: [id])
  desconto   Desconto?   @relation(fields: [descontoId], references: [id])
  notaFiscal NotaFiscal?

  @@index([alunoId])
  @@map("cobrancas")
}

model NotaFiscal {
  id         String    @id @default(uuid()) @db.Uuid
  numero     String    @unique @db.VarChar(30)
  tipo       String    @db.VarChar(20) // produto | servico
  cobrancaId String    @unique @map("cobranca_id") @db.Uuid
  caminhoPdf String    @map("caminho_pdf") @db.VarChar(255)
  status     String    @default("emitida") @db.VarChar(20) // emitida | cancelada
  emitidoEm  DateTime? @map("emitido_em") @db.Timestamp()

  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)

  @@map("notas_fiscais")
}

