generator client {
  provider = "prisma-client-js"
  output   = "../prisma-test-client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev-test.db"
}

model Usuario {
  id            String   @id @default(uuid())
  nome          String
  email         String   @unique
  senhaHash     String
  cpf           String?
  telefone      String?
  ativo         Boolean  @default(true)
  ultimoLogin   DateTime?
  criadoEm      DateTime?
  atualizadoEm  DateTime?

  permissoes    UsuarioPermissao[]
  setores       UsuarioSetor[]
  notificacoes  Notificacao[]
  sessoes       Sessao[]
  logsAuditoria LogAuditoria[]
  logsErro      LogErro[]
  ticketsCriados Ticket[] @relation("TicketSolicitante")
  ticketsTecnico Ticket[] @relation("TicketTecnico")
  mensagensTickets MensagemTicket[]
  anexosTickets AnexoTicket[]
  historicoTickets HistoricoTicket[]
  avaliacoesTickets AvaliacaoTicket[]
  mensagensReservas ReservaMensagem[]
  historicoReservas ReservaHistorico[]
  redefinicoesSenha RedefinicaoSenha[]
  professorAcademico Professor?
  alunoAcademico     Aluno?
  contaBoost         BoostUsuario?
  subcategoriasAtendidas AtendimentoSubcategoria[]
  politicasMultaJurosCriadas PoliticaMultaJuros[]
}

model RedefinicaoSenha {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Setor {
  id          String   @id @default(uuid())
  nome        String
  descricao   String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime?

  usuarios    UsuarioSetor[]
  categorias  CategoriaTicket[]
}

model Modulo {
  id          String   @id @default(uuid())
  nome        String   @unique
  rota        String?
  icone       String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime?

  permissoes  Permissao[]
}

model Permissao {
  id          String   @id @default(uuid())
  moduloId    String?
  nome        String
  descricao   String?
  recurso     String?
  acao        String?
  criadoEm    DateTime?

  modulo      Modulo? @relation(fields: [moduloId], references: [id])
  usuarios    UsuarioPermissao[]
}

model UsuarioPermissao {
  id          String   @id @default(uuid())
  usuarioId   String
  permissaoId String
  criadoEm    DateTime?

  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, permissaoId])
}

model UsuarioSetor {
  id          String   @id @default(uuid())
  usuarioId   String
  setorId     String
  criadoEm    DateTime?

  usuario     Usuario @relation(fields: [usuarioId], references: [id])
  setor       Setor   @relation(fields: [setorId], references: [id])
}

model Notificacao {
  id          String   @id @default(uuid())
  usuarioId   String?
  titulo      String?
  mensagem    String?
  rota        String?
  lida        Boolean  @default(false)
  criadoEm    DateTime?

  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
}

model Sessao {
  id            String   @id @default(uuid())
  usuarioId     String?
  refreshToken  String?
  ip            String?
  navegador     String?
  expiraEm      DateTime?
  revogada      Boolean  @default(false)
  criadoEm      DateTime?

  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
}

model LogAuditoria {
  id            String   @id @default(uuid())
  usuarioId     String?
  modulo        String?
  acao          String?
  entidade      String?
  entidadeId    String?
  ip            String?
  navegador     String?
  criadoEm      DateTime?

  usuario       Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
}

model LogErro {
  id          String    @id @default(uuid())
  usuarioId   String?
  metodo      String?
  rota        String?
  statusCode  Int
  mensagem    String
  stack       String?
  criadoEm    DateTime?

  usuario     Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([criadoEm])
}

model CategoriaTicket {
  id String @id @default(uuid())
  nome String
  descricao String?
  ativo Boolean @default(true)
  slaHoras Int @default(8)
  setorId String?
  criadoEm DateTime?
  subcategorias SubcategoriaTicket[]
  tickets Ticket[]
  setor Setor? @relation(fields: [setorId], references: [id])

  @@index([setorId])
}

model SubcategoriaTicket {
  id String @id @default(uuid())
  categoriaId String?
  nome String
  descricao String?
  ativo Boolean @default(true)
  slaHoras Int @default(8)
  criadoEm DateTime?
  categoria CategoriaTicket? @relation(fields: [categoriaId], references: [id])
  tickets Ticket[]
  atendentes AtendimentoSubcategoria[]
}

// Espelho de AtendimentoSubcategoria (schema.prisma) — faltava neste schema de
// teste, o que fazia GET /chamados-categorias (findCategoriesForUser, que
// inclui subcategorias.atendentes) estourar 500 sempre que exercitado contra
// SQLite. Nenhum teste chamava esse endpoint antes, então nunca foi pego —
// achado real, ao adicionar cobertura para o formulário de novo chamado.
model AtendimentoSubcategoria {
  id             String @id @default(uuid())
  subcategoriaId String
  usuarioId      String
  criadoEm       DateTime?

  subcategoria SubcategoriaTicket @relation(fields: [subcategoriaId], references: [id], onDelete: Cascade)
  usuario      Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([subcategoriaId, usuarioId])
}

model PrioridadeTicket {
  id String @id @default(uuid())
  nome String
  cor String?
  criadoEm DateTime?
  tickets Ticket[]
}

model StatusTicket {
  id String @id @default(uuid())
  nome String
  ordem Int?
  encerrado Boolean @default(false)
  criadoEm DateTime?
  tickets Ticket[]
}

model Ticket {
  id String @id @default(uuid())
  protocolo String? @unique
  titulo String
  descricao String
  usuarioId String?
  tecnicoId String?
  categoriaId String?
  subcategoriaId String?
  prioridadeId String?
  statusId String?
  tags String? // JSON — SQLite não suporta String[] nativo (ver prisma-test.service.ts)
  favorito Boolean @default(false)
  criadoEm DateTime?
  atualizadoEm DateTime?
  encerradoEm DateTime?
  usuario Usuario? @relation("TicketSolicitante", fields: [usuarioId], references: [id])
  tecnico Usuario? @relation("TicketTecnico", fields: [tecnicoId], references: [id])
  categoria CategoriaTicket? @relation(fields: [categoriaId], references: [id])
  subcategoria SubcategoriaTicket? @relation(fields: [subcategoriaId], references: [id])
  prioridade PrioridadeTicket? @relation(fields: [prioridadeId], references: [id])
  status StatusTicket? @relation(fields: [statusId], references: [id])
  mensagens MensagemTicket[]
  anexos AnexoTicket[]
  historico HistoricoTicket[]
  avaliacoes AvaliacaoTicket[]

  @@index([categoriaId])
  @@index([criadoEm])
}

model MensagemTicket {
  id String @id @default(uuid())
  ticketId String
  usuarioId String
  mensagem String
  interno Boolean @default(false)
  criadoEm DateTime @default(now())
  removidoEm DateTime?
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([ticketId, criadoEm])
}

model AnexoTicket {
  id String @id @default(uuid())
  ticketId String?
  usuarioId String?
  nomeArquivo String?
  caminho String?
  tipo String?
  tamanho BigInt?
  criadoEm DateTime?
  ticket Ticket? @relation(fields: [ticketId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model HistoricoTicket {
  id String @id @default(uuid())
  ticketId String?
  usuarioId String?
  campo String?
  valorAntigo String?
  valorNovo String?
  criadoEm DateTime?
  ticket Ticket? @relation(fields: [ticketId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model AvaliacaoTicket {
  id String @id @default(uuid())
  ticketId String?
  usuarioId String?
  nota Int?
  comentario String?
  criadoEm DateTime?
  ticket Ticket? @relation(fields: [ticketId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model Campus {
  id String @id @default(uuid())
  nome String
  codigo String @unique
  endereco String?
  cidade String?
  estado String?
  cep String?
  responsavel String?
  ativo Boolean @default(true)
  observacoes String?
  cor String?
  criadoEm DateTime?
  atualizadoEm DateTime?
  blocos Bloco[]
  ambientes Ambiente[]
}

model Bloco {
  id String @id @default(uuid())
  campusId String
  nome String
  codigo String
  andares Int @default(1)
  responsavel String?
  ativo Boolean @default(true)
  criadoEm DateTime?
  atualizadoEm DateTime?
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  ambientes Ambiente[]

  @@unique([campusId, codigo])
}

model Ambiente {
  id String @id @default(uuid())
  campusId String
  blocoId String
  nome String
  codigo String @unique
  andar Int @default(0)
  numero String?
  tipo String
  capacidade Int @default(0)
  area Decimal?
  descricao String?
  capa String?
  galeria String?
  recursos String? // JSON — mesmo shim de galeria
  status String @default("disponivel")
  horarioAbertura String?
  diasFuncionamento String?
  duracaoMinutos Int?
  criadoEm DateTime?
  atualizadoEm DateTime?
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  bloco Bloco @relation(fields: [blocoId], references: [id], onDelete: Cascade)
  reservas Reserva[]
}

model Reserva {
  id String @id @default(uuid())
  codigo String @unique
  ambienteId String
  responsavelId String?
  responsavel String
  setorId String?
  setor String?
  evento String
  finalidade String?
  data DateTime
  horarioInicio String
  horarioFim String
  participantes Int @default(1)
  status String @default("analise")
  turmaId String?
  recorrencia String @default("unica")
  serieId String?
  serieTotal Int?
  observacoes String?
  decididoPor String?
  decididoEm DateTime?
  motivoCancelamento String?
  criadoEm DateTime?
  atualizadoEm DateTime?
  ambiente Ambiente @relation(fields: [ambienteId], references: [id], onDelete: Restrict)
  turma Turma? @relation(fields: [turmaId], references: [id])
  mensagens ReservaMensagem[]
  historico ReservaHistorico[]
}

model ReservaMensagem {
  id String @id @default(uuid())
  reservaId String
  usuarioId String
  mensagem String
  criadoEm DateTime @default(now())
  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([reservaId, criadoEm])
}

model ReservaHistorico {
  id String @id @default(uuid())
  reservaId String
  usuarioId String?
  campo String?
  valorAntigo String?
  valorNovo String?
  criadoEm DateTime?
  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model PatrimonioCategoria {
  id String @id @default(uuid())
  nome String @unique
  descricao String?
  tom String?
  sistema Boolean @default(false)
  criadoEm DateTime?
  atualizadoEm DateTime?
  patrimonios Patrimonio[]
}

model PatrimonioSetor {
  id String @id @default(uuid())
  nome String @unique
  descricao String?
  responsavel String?
  criadoEm DateTime?
  atualizadoEm DateTime?
  patrimonios Patrimonio[]
}

model Patrimonio {
  id String @id @default(uuid())
  nome String
  tag String @unique
  categoriaId String
  marca String?
  modelo String?
  serial String?
  localizacaoId String?
  localizacao String?
  setorId String?
  setor String?
  responsavelUserId String?
  responsavel String?
  status String @default("disponivel")
  condicao String @default("bom")
  adquiridoEm DateTime?
  valor Decimal @default(0)
  observacoes String?
  foto String?
  chamadoManutencaoId String?
  criadoEm DateTime?
  atualizadoEm DateTime?
  categoria PatrimonioCategoria @relation(fields: [categoriaId], references: [id])
  setorRef PatrimonioSetor? @relation(fields: [setorId], references: [id])
  movimentacoes PatrimonioMovimento[]
}

model PatrimonioMovimento {
  id String @id @default(uuid())
  patrimonioId String
  tipo String
  origem String?
  destino String?
  usuario String
  observacoes String?
  dataDevolucaoPrevista DateTime?
  devolvidoEm DateTime?
  criadoEm DateTime?
  patrimonio Patrimonio @relation(fields: [patrimonioId], references: [id], onDelete: Cascade)
}

// Rooster Academy

model Curso {
  id String @id @default(uuid())
  nome String
  codigo String @unique
  grau String
  ativo Boolean @default(true)
  criadoEm DateTime?
  atualizadoEm DateTime?
  disciplinas Disciplina[]
  alunos Aluno[]
}

model PeriodoLetivo {
  id String @id @default(uuid())
  nome String @unique
  dataInicio DateTime
  dataFim DateTime
  ativo Boolean @default(false)
  criadoEm DateTime?
  turmas Turma[]
}

model Disciplina {
  id String @id @default(uuid())
  codigo String @unique
  nome String
  descricao String?
  cursoId String
  cargaHoraria Int
  status String @default("ativa")
  criadoEm DateTime?
  atualizadoEm DateTime?
  curso Curso @relation(fields: [cursoId], references: [id])
  turmas Turma[]
  documentos DocumentoAcademico[]
}

model Professor {
  id String @id @default(uuid())
  usuarioId String @unique
  titulacao String?
  departamento String?
  cargaHorariaSemanal Int?
  status String @default("ativo")
  criadoEm DateTime?
  atualizadoEm DateTime?
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  turmas Turma[]
  atividades Atividade[]
  orientacoesBoost CursoOrientadorBoost[]
  mensagensBoost MensagemBoost[]
}

model Aluno {
  id String @id @default(uuid())
  usuarioId String @unique
  ra String @unique
  cursoId String
  semestre Int @default(1)
  situacao String @default("ativo")
  criadoEm DateTime?
  atualizadoEm DateTime?
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  curso Curso @relation(fields: [cursoId], references: [id])
  matriculas Matricula[]
  frequencias RegistroFrequencia[]
  notas Nota[]
  entregas Entrega[]
  cobrancas Cobranca[]
  descontos DescontoAluno[]
}

model Turma {
  id String @id @default(uuid())
  codigo String
  disciplinaId String
  periodoLetivoId String
  professorId String?
  turno String?
  capacidade Int @default(0)
  sala String?
  horario String?
  status String @default("aberta")
  criadoEm DateTime?
  atualizadoEm DateTime?
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id])
  periodoLetivo PeriodoLetivo @relation(fields: [periodoLetivoId], references: [id])
  professor Professor? @relation(fields: [professorId], references: [id])
  matriculas Matricula[]
  frequencias RegistroFrequencia[]
  itensAvaliativos ItemAvaliativo[]
  atividades Atividade[]
  reservasVinculadas Reserva[]

  @@unique([codigo, periodoLetivoId])
}

model Matricula {
  id String @id @default(uuid())
  alunoId String
  turmaId String
  status String @default("ativa")
  criadoEm DateTime?
  atualizadoEm DateTime?
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, turmaId])
}

model RegistroFrequencia {
  id String @id @default(uuid())
  turmaId String
  alunoId String
  data DateTime
  presenca String
  registradoPorId String?
  criadoEm DateTime?
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([turmaId, alunoId, data])
  @@index([alunoId])
}

model ItemAvaliativo {
  id String @id @default(uuid())
  turmaId String
  nome String
  peso Decimal
  notaMaxima Decimal @default(10)
  origem String @default("manual")
  atividadeId String? @unique
  criadoEm DateTime?
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  atividade Atividade? @relation(fields: [atividadeId], references: [id])
  notas Nota[]
}

model Nota {
  id String @id @default(uuid())
  itemAvaliativoId String
  alunoId String
  valor Decimal?
  lancadoPorId String?
  atualizadoEm DateTime?
  itemAvaliativo ItemAvaliativo @relation(fields: [itemAvaliativoId], references: [id], onDelete: Cascade)
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([itemAvaliativoId, alunoId])
}

model EventoCalendarioAcademico {
  id String @id @default(uuid())
  titulo String
  data DateTime
  dataFim DateTime?
  horario String?
  tipo String
  publico String?
  local String?
  criadoEm DateTime?
}

model DocumentoAcademico {
  id String @id @default(uuid())
  nome String
  tipo String
  disciplinaId String?
  autorId String?
  caminho String?
  tamanho BigInt?
  criadoEm DateTime?
  atualizadoEm DateTime?
  disciplina Disciplina? @relation(fields: [disciplinaId], references: [id])
}

// Rooster Learn

model Atividade {
  id String @id @default(uuid())
  codigo String? @unique
  titulo String
  tipo String
  descricao String?
  turmaId String
  professorId String?
  status String @default("rascunho")
  peso Decimal @default(1)
  notaMaxima Decimal @default(10)
  abreEm DateTime?
  prazoEm DateTime?
  tempoLimiteMin Int?
  permiteAtraso Boolean @default(true)
  criadoEm DateTime?
  publicadoEm DateTime?
  turma Turma @relation(fields: [turmaId], references: [id])
  professor Professor? @relation(fields: [professorId], references: [id])
  itemAvaliativo ItemAvaliativo?
  entregas Entrega[]
}

model Entrega {
  id String @id @default(uuid())
  atividadeId String
  alunoId String
  status String @default("pendente")
  texto String?
  enviadoEm DateTime?
  nota Decimal?
  feedback String?
  corrigidoPorId String?
  corrigidoEm DateTime?
  atividade Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  anexos AnexoEntrega[]

  @@unique([atividadeId, alunoId])
}

model AnexoEntrega {
  id String @id @default(uuid())
  entregaId String
  nomeArquivo String?
  caminho String?
  tipo String?
  tamanho BigInt?
  criadoEm DateTime?
  entrega Entrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)
}

model BoostUsuario {
  id String @id @default(uuid())
  nome String
  email String @unique
  senhaHash String
  ativo Boolean @default(true)
  criadoEm DateTime?
  usuarioId String? @unique
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  redefinicoesSenha RedefinicaoSenhaBoost[]
  matriculas MatriculaBoost[]
  mensagens MensagemBoost[]
  conversas ConversaBoost[]
}

model RedefinicaoSenhaBoost {
  id String @id @default(uuid())
  boostUsuarioId String
  tokenHash String @unique
  expiraEm DateTime
  usadoEm DateTime?
  criadoEm DateTime @default(now())
  boostUsuario BoostUsuario @relation(fields: [boostUsuarioId], references: [id], onDelete: Cascade)

  @@index([boostUsuarioId])
}

model CursoBoost {
  id String @id @default(uuid())
  titulo String
  slug String @unique
  descricao String?
  categoria String?
  nivel String @default("iniciante")
  cargaHoraria Int
  capa String?
  status String @default("rascunho")
  emiteCertificado Boolean @default(true)
  certificadoTexto String?
  criadoEm DateTime?
  atualizadoEm DateTime?
  modulos ModuloBoost[]
  matriculas MatriculaBoost[]
  orientadores CursoOrientadorBoost[]
  conversas ConversaBoost[]
}

model CursoOrientadorBoost {
  id String @id @default(uuid())
  cursoId String
  professorId String
  criadoEm DateTime?
  curso CursoBoost @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  professor Professor @relation(fields: [professorId], references: [id])
  @@unique([cursoId, professorId])
}

model ConversaBoost {
  id String @id @default(uuid())
  cursoId String
  boostUsuarioId String
  criadoEm DateTime?
  ultimaMensagemEm DateTime?
  curso CursoBoost @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  boostUsuario BoostUsuario @relation(fields: [boostUsuarioId], references: [id], onDelete: Cascade)
  mensagens MensagemBoost[]
  @@unique([cursoId, boostUsuarioId])
}

model ModuloBoost {
  id String @id @default(uuid())
  cursoId String
  titulo String
  ordem Int @default(0)
  curso CursoBoost @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  aulas AulaBoost[]
}

model AulaBoost {
  id String @id @default(uuid())
  moduloId String
  titulo String
  ordem Int @default(0)
  tipo String @default("texto")
  conteudoUrl String?
  conteudoTexto String?
  duracaoMin Int?
  videoArquivo String?
  videoTamanho BigInt?
  videoMimeType String?
  modulo ModuloBoost @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  materiais MaterialApoio[]
  progresso ProgressoAula[]
}

model MaterialApoio {
  id String @id @default(uuid())
  aulaId String
  nome String
  caminho String
  tipo String?
  tamanho BigInt?
  criadoEm DateTime?
  aula AulaBoost @relation(fields: [aulaId], references: [id], onDelete: Cascade)
}

model MatriculaBoost {
  id String @id @default(uuid())
  boostUsuarioId String
  cursoId String
  status String @default("ativa")
  progressoPct Int @default(0)
  matriculadoEm DateTime?
  concluidoEm DateTime?
  boostUsuario BoostUsuario @relation(fields: [boostUsuarioId], references: [id], onDelete: Cascade)
  curso CursoBoost @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  progresso ProgressoAula[]
  certificado CertificadoBoost?

  @@unique([boostUsuarioId, cursoId])
}

model ProgressoAula {
  id String @id @default(uuid())
  matriculaId String
  aulaId String
  concluidoEm DateTime?
  posicaoSeg Int? @default(0)
  percentualAssistido Int? @default(0)
  matricula MatriculaBoost @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  aula AulaBoost @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([matriculaId, aulaId])
}

model MensagemBoost {
  id String @id @default(uuid())
  conversaId String
  boostUsuarioId String?
  professorId String?
  mensagem String
  lidaEm DateTime?
  criadoEm DateTime?
  conversa ConversaBoost @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  boostUsuario BoostUsuario? @relation(fields: [boostUsuarioId], references: [id])
  professor Professor? @relation(fields: [professorId], references: [id])
}

model CertificadoBoost {
  id String @id @default(uuid())
  matriculaId String @unique
  codigo String @unique
  caminhoPdf String
  emitidoEm DateTime?
  matricula MatriculaBoost @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
}

model Produto {
  id String @id @default(uuid())
  codigo String @unique
  nome String
  categoria String?
  descricao String?
  preco Decimal
  estoque Int @default(0)
  estoqueMinimo Int @default(0)
  unidade String @default("un")
  ativo Boolean @default(true)
  criadoEm DateTime?
  atualizadoEm DateTime?
  cobrancas Cobranca[]
}

model Servico {
  id String @id @default(uuid())
  nome String
  descricao String?
  preco Decimal
  categoria String?
  frequencia String @default("unico")
  ativo Boolean @default(true)
  politicaMultaJurosId String?
  criadoEm DateTime?
  atualizadoEm DateTime?
  politicaMultaJuros PoliticaMultaJuros? @relation(fields: [politicaMultaJurosId], references: [id])
  cobrancas Cobranca[]
}

model Desconto {
  id String @id @default(uuid())
  nome String
  tipo String
  valor Decimal
  unidade String
  motivo String?
  responsavel String?
  vigenciaInicio DateTime?
  vigenciaFim DateTime?
  ativo Boolean @default(true)
  criadoEm DateTime?
  atualizadoEm DateTime?
  cobrancas Cobranca[]
  alunos DescontoAluno[]
}

model DescontoAluno {
  id String @id @default(uuid())
  alunoId String
  descontoId String
  atribuidoEm DateTime?
  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  desconto Desconto @relation(fields: [descontoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, descontoId])
}

model PoliticaMultaJuros {
  id String @id @default(uuid())
  nome String
  descricao String?
  percentualMulta Decimal @default(0)
  percentualJurosDia Decimal @default(0)
  diasCarencia Int @default(0)
  ativo Boolean @default(true)
  criadoPorId String?
  criadoEm DateTime?
  atualizadoEm DateTime?
  criadoPor Usuario? @relation(fields: [criadoPorId], references: [id])
  servicos Servico[]
  cobrancas Cobranca[]
}

model Cobranca {
  id String @id @default(uuid())
  alunoId String
  tipo String
  descricao String
  competencia String?
  produtoId String?
  servicoId String?
  descontoId String?
  valorOriginal Decimal
  valorDesconto Decimal @default(0)
  multa Decimal @default(0)
  juros Decimal @default(0)
  politicaMultaJurosId String?
  valorPago Decimal?
  vencimento DateTime
  status String @default("aberto")
  formaPagamento String?
  nossoNumero String? @unique
  linhaDigitavel String?
  pixCopiaECola String?
  emitidoEm DateTime?
  pagoEm DateTime?
  negociadoEm DateTime?
  motivoCancelamento String?
  criadoEm DateTime? @default(now())
  atualizadoEm DateTime?
  aluno Aluno @relation(fields: [alunoId], references: [id])
  produto Produto? @relation(fields: [produtoId], references: [id])
  servico Servico? @relation(fields: [servicoId], references: [id])
  desconto Desconto? @relation(fields: [descontoId], references: [id])
  politicaMultaJuros PoliticaMultaJuros? @relation(fields: [politicaMultaJurosId], references: [id])
  notaFiscal NotaFiscal?

  @@index([alunoId])
}

model NotaFiscal {
  id String @id @default(uuid())
  numero String @unique
  tipo String
  cobrancaId String @unique
  caminhoPdf String
  status String @default("emitida")
  emitidoEm DateTime?
  cobranca Cobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)
}
