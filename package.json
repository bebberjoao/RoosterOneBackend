{
  "name": "rooster-one-api",
  "version": "0.0.1",
  "description": "Backend modular do Rooster One com Rooster Hub",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "db:seed:dev": "ts-node prisma/seed-dev.ts",
    "prisma:generate:test": "prisma generate --schema ./prisma/schema.test.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:db:push:test": "prisma db push --schema ./prisma/schema.test.prisma",
    "test:e2e": "cross-env DATABASE_URL=file:./prisma/dev-test.db npm run prisma:db:push:test && cross-env DATABASE_URL=file:./prisma/dev-test.db jest --config ./jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@prisma/engines": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^2.0.16",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
