{
  "name": "rooster-one-api",
  "version": "0.0.1",
  "description": "Backend modular do Rooster One com Rooster Hub",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "jest --config ./jest-unit.json",
    "prisma:generate": "prisma generate",
    "db:seed:dev": "ts-node prisma/seed-dev.ts",
    "prisma:generate:test": "prisma generate --schema ./prisma/schema.test.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:db:push:test": "prisma db push --schema ./prisma/schema.test.prisma",
    "test:e2e": "cross-env DATABASE_URL=file:./prisma/dev-test.db npm run prisma:db:push:test && cross-env DATABASE_URL=file:./prisma/dev-test.db JWT_SECRET=rooster-e2e-test-secret FILE_ENCRYPTION_KEY=/JgqJCHHkibI+uTXm5rTjW2UwxVUnXxbWEFvhb3TbfY= jest --config ./jest-e2e.json",
    "test:watch": "jest --config ./jest-unit.json --watch",
    "audit": "npm audit --omit=dev",
    "test:all": "npm test && npm run test:e2e",
    "load-test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@prisma/engines": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^2.0.16",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.4.3"
    }
  }
}
