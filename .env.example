# Rooster One — backend
#
# Copie para `.env` e preencha. Este arquivo é versionado de propósito e só
# contém exemplos: NUNCA coloque um valor real de segredo aqui.

# ---------------------------------------------------------------------------
# Obrigatórias — a aplicação não sobe sem elas
# ---------------------------------------------------------------------------

# Conexão do PostgreSQL usada pelo Prisma (prisma/schema.prisma).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/rooster_one?schema=public"

# Segredo de assinatura do JWT. Sem ele a aplicação encerra na inicialização
# (src/auth/jwt-config.ts) — é proposital, para nunca subir com segredo padrão.
# Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# ---------------------------------------------------------------------------
# Opcionais — têm valor padrão no código
# ---------------------------------------------------------------------------

# Porta HTTP do backend (padrão: 3000).
PORT=3000

# Base do frontend, usada para montar o link do e-mail de redefinição de senha
# (padrão: http://localhost:8080).
FRONTEND_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# Pastas de arquivos enviados (opcionais)
# ---------------------------------------------------------------------------
# Onde ficam anexo de chamado, documento acadêmico, material e vídeo de curso,
# certificado e nota fiscal. Caminho relativo é resolvido a partir do diretório
# de trabalho; absoluto é usado como está.
#
# Num servidor Windows, vale apontar para fora da pasta da aplicação: assim o
# conteúdo sobrevive a uma reinstalação e pode ficar num disco de dados.
#
# Raiz de todos os uploads (padrão: <pasta da aplicação>/uploads).
# UPLOADS_DIR="D:\rooster-dados\uploads"

# Vídeo de aula tem variável própria porque é, de longe, o arquivo maior do
# sistema — normalmente pertence a um disco separado do da aplicação.
# BOOST_VIDEOS_DIR="E:\rooster-videos"

# As demais só precisam ser definidas para sair do padrão sob UPLOADS_DIR:
# BOOST_MATERIAIS_DIR=
# BOOST_CERTIFICADOS_DIR=
# DESK_ANEXOS_DIR=
# LEARN_ANEXOS_DIR=
# ACADEMY_DOCUMENTOS_DIR=
# FINANCE_NOTAS_DIR=

# ---------------------------------------------------------------------------
# E-mail (opcional) — sem SMTP_HOST, o MailService entra em modo de log:
# o link de redefinição de senha aparece no console em vez de ser enviado.
# ---------------------------------------------------------------------------

MAIL_FROM="Rooster One <no-reply@rooster.local>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# ---------------------------------------------------------------------------
# NODE_ENV não precisa ser definido manualmente: o Jest define `test` sozinho,
# e é isso que relaxa os limites de rate limiting durante a suíte e2e
# (src/auth/throttle.util.ts). Defini-lo como `test` fora dos testes
# desprotegeria as rotas de autenticação.
# ---------------------------------------------------------------------------
