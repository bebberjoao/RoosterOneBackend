# Rooster One — backend
#
# Copie este arquivo para `.env` e preencha os valores. Este arquivo é versionado e contém apenas
# exemplos: nenhum valor real de segredo deve ser registrado aqui.

# ---------------------------------------------------------------------------
# Obrigatórias — a aplicação não inicia sem elas
# ---------------------------------------------------------------------------

# Conexão do PostgreSQL utilizada pelo Prisma (prisma/schema.prisma).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/rooster_one?schema=public"

# Segredo de assinatura do JWT. Na ausência dele, a aplicação é encerrada na inicialização
# (src/auth/jwt-config.ts), para impedir a execução com segredo padrão.
# Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Chave mestra de criptografia em repouso de todo arquivo gravado em disco (anexo de chamado,
# documento acadêmico, anexo de entrega, material e vídeo do Boost, certificado e nota fiscal) —
# ver src/common/file-encryption.util.ts. Na ausência dela, a aplicação é encerrada na inicialização.
# Deve decodificar (base64) para exatamente 32 bytes (AES-256). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: a perda desta chave, ou sua troca sem nova cifragem dos arquivos, torna ilegível todo
# arquivo já gravado. A chave exige o mesmo cuidado de backup do banco de dados
# (ver docs/operations/06-backup-e-recuperacao.md).
FILE_ENCRYPTION_KEY="troque-por-32-bytes-aleatorios-em-base64"

# ---------------------------------------------------------------------------
# Opcionais — possuem valor padrão no código
# ---------------------------------------------------------------------------

# Porta HTTP do backend (padrão: 3000).
PORT=3000

# Endereço do frontend, utilizado para compor o link do e-mail de redefinição de senha
# (padrão: http://localhost:8080). A origem deste endereço também é aceita pelo CORS.
FRONTEND_URL="http://localhost:8080"

# Origens adicionais aceitas pelo CORS, separadas por vírgula (src/common/cors.ts). Em produção
# (NODE_ENV=production), somente estas origens e a de FRONTEND_URL são aceitas; fora de produção,
# localhost e 127.0.0.1 em qualquer porta também são aceitos.
# CORS_ORIGINS="https://rooster.instituicao.edu.br,https://admin.instituicao.edu.br"

# Documentação interativa da API (/api/docs). Em produção, fica desabilitada salvo definição
# explícita desta variável como "true"; fora de produção, está sempre disponível.
# SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Pastas de arquivos enviados (opcionais)
# ---------------------------------------------------------------------------
# Localização de anexos de chamado, documentos acadêmicos, materiais e vídeos de curso,
# certificados e notas fiscais. Caminho relativo é resolvido a partir do diretório de trabalho;
# caminho absoluto é utilizado sem alteração. Os scripts de backup e restauração aplicam a mesma
# regra (scripts/pastas-upload.ps1 e scripts/pastas-upload.sh).
#
# Em servidor Windows, recomenda-se apontar para fora da pasta da aplicação, para que o conteúdo
# seja preservado em uma reinstalação e possa residir em disco de dados.
#
# Raiz de todos os uploads (padrão: <pasta da aplicação>/uploads).
# UPLOADS_DIR="D:\rooster-dados\uploads"

# O vídeo de aula possui variável própria por ser o maior tipo de arquivo do sistema,
# normalmente alocado em disco distinto do da aplicação.
# BOOST_VIDEOS_DIR="E:\rooster-videos"

# As demais variáveis só precisam ser definidas para alterar o padrão sob UPLOADS_DIR:
# BOOST_MATERIAIS_DIR=
# BOOST_CERTIFICADOS_DIR=
# DESK_ANEXOS_DIR=
# LEARN_ANEXOS_DIR=
# LEARN_IMAGENS_DIR=
# ACADEMY_DOCUMENTOS_DIR=
# FINANCE_NOTAS_DIR=

# ---------------------------------------------------------------------------
# E-mail (opcional) — sem SMTP_HOST, o MailService opera em modo de registro:
# o link de redefinição de senha é registrado no log (com o token mascarado) em vez de enviado.
# ---------------------------------------------------------------------------

MAIL_FROM="Rooster One <no-reply@rooster.local>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# ---------------------------------------------------------------------------
# NODE_ENV não precisa ser definido em desenvolvimento: o Jest define `test` automaticamente, o que
# flexibiliza os limites de requisição durante a suíte e2e (src/auth/throttle.util.ts). A definição
# de `test` fora dos testes desprotegeria as rotas de autenticação. Em produção, deve ser definido
# como `production`, o que ativa: log em JSON, CORS restrito às origens configuradas, Swagger
# desabilitado e Content-Security-Policy.
# ---------------------------------------------------------------------------
