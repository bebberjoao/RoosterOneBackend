flowchart TD
  LOGIN["POST /auth/login<br/>devolve acesso.permissoes"] --> SES["1. Sessao<br/>session.permissoes:<br/>permissoes reais"]
  SES --> PC["2. PermissionProvider<br/>usePermissions, useCan<br/>e useCanAccess"]
  PC --> RA["RequireAccess no AppShell<br/>decide se a ROTA abre"]
  PC --> BTN["useCan por acao<br/>decide se o BOTAO aparece"]
  SES --> PERF["3. Perfil de interface<br/>deduzido das permissoes<br/>(deriveRole), sem<br/>troca manual"]
  PERF --> MENU["Menus e matrizes dos<br/>modulos: so organizam<br/>a tela (E logico com<br/>a permissao real)"]
  MENU --> BTN

  AVISO{{"Nenhuma camada do<br/>frontend e fronteira<br/>de seguranca:<br/>o backend revalida<br/>cada requisicao"}}
  BTN -.-> AVISO

  classDef real fill:#E8EEF7,stroke:#2E5395,color:#1F3864
  classDef perfil fill:#FDF2E0,stroke:#B4741A,color:#6B4410
