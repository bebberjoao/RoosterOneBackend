%%{init: {"flowchart":{"subGraphTitleMargin":{"top":6,"bottom":12},"nodeSpacing":26,"rankSpacing":32,"padding":6,"diagramPadding":6}}}%%
graph TB
  subgraph Classico["RBAC classico - NAO usado aqui"]
    CU[Usuario] --> CP[Perfil / Role] --> CPE[Permissoes]
  end

  subgraph Rooster["Rooster One - RBAC achatado"]
    U[Usuario] --> UP[UsuarioPermissao] --> P[Permissao]
    P --> M[Modulo]
  end

  KEY["Chave efetiva de autorizacao:<br/>Modulo.nome + Permissao.recurso + Permissao.acao<br/>comparados por igualdade exata de string"]
  P -.-> KEY

  ADMIN["Administrador =<br/>ter a permissao<br/>Rooster Hub /<br/>/hub/acessos /<br/>gerenciar-permissoes<br/>(concede bypass total<br/>no PermissionGuard)"]
  KEY -.-> ADMIN

  classDef nao fill:#F2F2F2,stroke:#999,color:#777
  classDef sim fill:#E8EEF7,stroke:#2E5395,color:#1F3864
  classDef destaque fill:#FDF2E0,stroke:#B4741A,color:#6B4410
  class CU,CP,CPE nao
  class U,UP,P,M sim
  class KEY,ADMIN destaque
