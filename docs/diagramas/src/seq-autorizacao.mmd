sequenceDiagram
  participant FE as Frontend
  participant JWT as JwtAuthGuard
  participant PG as Permission<br/>Guard
  participant SVC as Usuarios<br/>Service
  participant DB as PostgreSQL
  participant CTRL as Controller
  FE->>JWT: requisicao + Bearer token
  JWT->>JWT: verifica assinatura e expiracao
  JWT->>DB: busca o usuario do token
  alt token invalido ou usuario inativo
    JWT-->>FE: 401
  else token valido e usuario ativo
    JWT->>PG: request.user = usuario
    PG->>PG: le metadata @RequirePermission
    PG->>SVC: isAdmin(usuarioId)
    SVC->>DB: getAccess(usuarioId):<br/>permissoes efetivas
    alt e administrador
      PG->>CTRL: libera (bypass total)
    else nao e admin
      PG->>SVC: hasPermission(modulo, recurso, acao)
      alt tem a permissao
        PG->>CTRL: libera
      else nao tem
        PG-->>FE: 403 Forbidden
      end
    end
    CTRL-->>FE: resposta
  end
