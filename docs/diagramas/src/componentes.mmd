%%{init: {"flowchart":{"subGraphTitleMargin":{"top":6,"bottom":12},"nodeSpacing":22,"rankSpacing":36,"padding":6,"diagramPadding":6}}}%%
graph LR
  APP[AppModule]

  subgraph Negocio["Modulos de dominio"]
    direction TB
    HUB["RoosterHubModule<br/>UsuariosService, usado<br/>pelos modulos internos<br/>para verificar permissoes"]
    DESK[RoosterDeskModule]
    ASSETS[RoosterAssetsModule]
    ROOMS[RoosterRoomsModule]
    LEARN[RoosterLearnModule]
    FIN[RoosterFinanceModule]
    BOOST[RoosterBoostModule]
    BPORT[RoosterBoostPortalModule]
    ACAD[RoosterAcademyModule]
    ROOMS -.->|injeta| ACAD
    LEARN -.->|injeta| ACAD
    FIN -.->|injeta| ACAD
    BOOST -.->|injeta| ACAD
    BPORT -.->|injeta| BOOST
  end

  subgraph Transversais
    direction TB
    AUTH["AuthModule<br/>JwtAuthGuard e<br/>ThrottlerGuard globais"]
    ASSIST["AssistenteModule<br/>assistente de duvidas"]
    PRIS["PrismaModule<br/>PrismaService"]
    AUD["AuditoriaModule<br/>registro de eventos"]
    MAIL["MailModule<br/>nodemailer"]
  end

  APP --> Negocio
  APP --> Transversais
  Negocio -->|"todos usam o<br/>PrismaService"| PRIS
